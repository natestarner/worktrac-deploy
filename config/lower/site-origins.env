# This environment's own addresses, filled into the marketing site and the app's index.html before
# upload (tools/fill-site-origins.sh, shipped with each release from worktrac-source's scripts/).
# Link previews and crawlers read these from the raw HTML, so they can't come from config.json.
SITE_ORIGIN=https://dev.huddle.fitness
APP_ORIGIN=https://app.dev.huddle.fitness
# Lower must never be indexed alongside production; robots.txt disallows it too.
SITE_ROBOTS=noindex, nofollow
